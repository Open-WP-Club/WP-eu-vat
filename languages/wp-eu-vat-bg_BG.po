#: wp-eu-vat.php:62
msgid "VAT Number"
msgstr "ДДС номер"

#: wp-eu-vat.php:63
msgid "Enter VAT Number"
msgstr "Въведете ДДС номер"

#: wp-eu-vat.php:73
msgid "Invalid VAT number. Please check and try again."
msgstr "Невалиден ДДС номер. Моля, проверете и опитайте отново."

#: wp-eu-vat.php:110
msgid "Your billing country does not match your detected location. Please update your billing information or confirm your location."
msgstr "Вашата държава за фактуриране не съвпада с установената ви локация. Моля, актуализирайте информацията си или потвърдете местоположението."

#: wp-eu-vat.php:307
msgid "Your billing country does not match your detected location. Please verify your information or confirm your location."
msgstr "Вашата държава за фактуриране не съвпада с установената ви локация. Моля, проверете информацията си или потвърдете местоположението."

#: wp-eu-vat.php:319
msgid "EU VAT Validation"
msgstr "ЕС ДДС валидация"

#: wp-eu-vat.php:321
msgid "Configure EU VAT number validation settings"
msgstr "Конфигуриране на настройките за валидация на ЕС ДДС номера"

#: wp-eu-vat.php:327
msgid "Enable VIES Validation"
msgstr "Активиране на VIES валидация"

#: wp-eu-vat.php:328
msgid "Validate VAT numbers against the European VIES system in real-time"
msgstr "Валидиране на ДДС номера срещу европейската VIES система в реално време"

#: wp-eu-vat.php:334
msgid "Cache Duration"
msgstr "Продължителност на кеша"

#: wp-eu-vat.php:335
msgid "How long to cache validation results (in hours)"
msgstr "Колко дълго да се кешират резултатите от валидацията (в часове)"

#: wp-eu-vat.php:346
msgid "Clear VAT Cache"
msgstr "Изчистване на ДДС кеш"

#: wp-eu-vat.php:347
msgid "Clear all cached VAT validation results"
msgstr "Изчистване на всички кеширани резултати от ДДС валидация"

#: wp-eu-vat.php:393
msgid "VAT validation cache has been cleared."
msgstr "Кешът за ДДС валидация беше изчистен."

#: wp-eu-vat.php:421
msgid "Clear Cache Now"
msgstr "Изчисти кеша сега"
